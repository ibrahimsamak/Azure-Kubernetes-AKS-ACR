<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test names read as sentences; that is the point of them. -->
    <!-- CA1711: xUnit's collection-definition class is named by convention, not by us. -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\OrderFlow.Messaging\OrderFlow.Messaging.csproj" />
    <ProjectReference Include="..\..\src\Services\Order\OrderFlow.Order.Api\OrderFlow.Order.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Inventory\OrderFlow.Inventory.Api\OrderFlow.Inventory.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Payment\OrderFlow.Payment.Api\OrderFlow.Payment.Api.csproj" />
  </ItemGroup>

</Project>