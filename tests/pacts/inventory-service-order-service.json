        "customerId": "CUST-1",
        "lines": [
          {
            "quantity": 2,
            "sku": "SKU-1",
            "unitPrice": 29.99
          }
        ],
        "messageId": "0192f3a0-0000-7000-8000-000000000000",
        "occurredOnUtc": "2026-09-11T10:00:00Z",
        "orderId": "0192f3a0-0000-7000-8000-000000000000",
        "totalAmount": 59.98
      },
      "description": "an OrderPlaced event with two lines",
      "matchingRules": {
        "body": {
          "$.correlationId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.currency": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "^[A-Z]{3}$"
              }
            ]
          },
          "$.customerId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.lines": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type",
                "min": 1
              }
            ]
          },
          "$.lines[*].quantity": {
            "combine": "AND",
            "matchers": [
              {
                "match": "integer"
              }
            ]
          },
          "$.lines[*].sku": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.lines[*].unitPrice": {
            "combine": "AND",
            "matchers": [
              {
                "match": "decimal"
              }
            ]
          },
          "$.messageId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.occurredOnUtc": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.orderId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.totalAmount": {
            "combine": "AND",
            "matchers": [
              {
                "match": "decimal"
              }
            ]
          }
        }
      },
      "metadata": {
        "contentType": "application/json"
      }
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.0",
      "models": "1.0.4"
    },
    "pactSpecification": {
