{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "order",
        "AuthorizationPolicy": "authenticated-user",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "order": {
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "Destinations": {
          "primary": { "Address": "http://order" }
        }
      }
    }
  }
}
